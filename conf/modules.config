/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process ext.args. Included from each executor config so it is picked up
    even when the pipeline is launched with `-C` (which ignores the top-level
    nextflow.config).
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    withName: 'SRATOOLS_PREFETCH' {
        // Raise prefetch's download size ceiling (default sra-tools limit is 20G).
        // Falls back to 50G if maxDownloadSize is not set in the launch config.
        ext.args = "--max-size ${params.maxDownloadSize ?: '50G'}"
    }
}
