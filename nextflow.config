params {
  input = "$launchDir/data/"
  samplesheetName = "samplesheet.csv"
  fromSra = true
  outDir = "$launchDir/ngs-samples-output"

  // Target organism FASTA. REQUIRED — on-target fraction cannot be estimated without it,
  // and genome size is measured from it rather than hand-entered.
  referenceFasta = null

  // Subsampling parameters
  assayType = "DNASeq"   // DNASeq | RNASeq | ChipSeq. RNASeq and ChipSeq use a fixed 20M
                         // fragment target; only DNASeq uses targetCoverage. Unrecognized
                         // values fail loudly.
  targetCoverage = 60

  // Fraction floor, which doubles as the inflation cap: 0.05 means never retaining more
  // than 20x what a clean sample would need.
  minOnTargetFraction = 0.05
  // Below this a sample is flagged. Every sample flagged usually means the wrong reference.
  minPlausibleFraction = 0.01
  // Reads drawn per sample to estimate contamination.
  pilotSize = 100000

  // Maximum SRA file size prefetch will download. Raise this if prefetch skips a
  // large run with "is larger than maximum allowed" (default sra-tools limit is 20G).
  maxDownloadSize = "50G"
}

process {
  maxForks = 2
}

includeConfig "$baseDir/conf/docker.config"

apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'

workDir = "$launchDir/ngs-samples-work"
